PORT=5000
MONGODB_URI=mongodb://localhost:27017/neuramind
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Legacy single-provider configuration
AI_API_KEY=
AI_MODEL=gemini-3.6-flash

# Optional multi-provider configuration (Resilience & Failover Pool)
# Note: Configuring multiple API credentials provides automatic failover during outages/rate limits.
# It does NOT multiply or bypass Google Gemini rate limits, quotas, or billing policies.
AI_PROVIDER_1_API_KEY=
AI_PROVIDER_1_MODEL=gemini-3.6-flash
AI_PROVIDER_1_ENABLED=true

AI_PROVIDER_2_API_KEY=
AI_PROVIDER_2_MODEL=gemini-3.6-flash
AI_PROVIDER_2_ENABLED=true

AI_PROVIDER_3_API_KEY=
AI_PROVIDER_3_MODEL=gemini-3.6-flash
AI_PROVIDER_3_ENABLED=true

AI_PROVIDER_4_API_KEY=
AI_PROVIDER_4_MODEL=gemini-3.6-flash
AI_PROVIDER_4_ENABLED=true

AI_PROVIDER_5_API_KEY=
AI_PROVIDER_5_MODEL=gemini-3.6-flash
AI_PROVIDER_5_ENABLED=true

# Provider Manager Resiliency Settings
AI_MAX_RETRIES=2
AI_PROVIDER_COOLDOWN_MS=60000
AI_REQUEST_TIMEOUT_MS=120000
