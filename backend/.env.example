PORT=5000
MONGODB_URI=mongodb://localhost:27017/neuramind
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Legacy single-provider configuration
AI_API_KEY=
AI_MODEL=gemini-3.6-flash

# Optional multi-provider configuration (Resilience & Failover Pool)
AI_PROVIDER_1_API_KEY=
AI_PROVIDER_1_MODEL=gemini-3.6-flash
AI_PROVIDER_1_ENABLED=true

AI_PROVIDER_2_API_KEY=
AI_PROVIDER_2_MODEL=gemini-3.6-flash
AI_PROVIDER_2_ENABLED=true

# Provider Manager Resiliency Settings
AI_MAX_RETRIES=2
AI_PROVIDER_COOLDOWN_MS=60000
AI_REQUEST_TIMEOUT_MS=120000

# Authentication & Session Security
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email Provider (Nodemailer SMTP sends to ANY email address worldwide!)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Resend Email Alternative
RESEND_API_KEY=
EMAIL_FROM=NeuraMind <onboarding@resend.dev>
